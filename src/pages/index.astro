---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<main>
		<div class="card">
			<h1>Sistema de Facturación</h1>
			<p>Bienvenido al panel de gestión</p>

			<a href="/clientes" class="btn-opcion">
				<span class="icon">👥</span>
				<span>Gestión de Clientes</span>
			</a>
			<br />
			<a href="/facturas" class="btn-opcion">
				<span class="icon">🧾</span>
				<span>Gestión de Facturas</span>
			</a>
			<br />
			<a href="/establecimientos" class="btn-opcion">
				<span class="icon">🏢</span>
				<span>Gestión de Establecimientos</span>
			</a>
			<br />
			<a href="/auditoria" class="btn-opcion">
				<span class="icon">📊</span>
				<span>Revisión de Auditoría</span>
			</a>
		</div>
	</main>
</Layout>

<style>
	:root {
		--primary: #0ea5e9;
		--primary-dark: #1e3a8a;
		--accent: #38bdf8;
		--bg: #f0f9ff;
	}

	body {
		background: linear-gradient(
			135deg,
			#e0f2fe 0%,
			#c7d2fe 50%,
			#e9d5ff 100%
		);
		background-attachment: fixed;
		color: #1e293b;
		font-family: "Inter", system-ui, sans-serif;
		margin: 0;
		min-height: 100vh;
		display: grid;
		place-items: center;
	}

	main {
		padding: 1.5rem;
		width: 100%;
		max-width: 480px;
	}

	.card {
		background: rgba(255, 255, 255, 0.8);
		backdrop-filter: blur(12px);
		padding: 3.5rem 2.5rem;
		border-radius: 2rem;
		text-align: center;
		box-shadow:
			0 20px 25px -5px rgba(0, 0, 0, 0.05),
			0 8px 10px -6px rgba(0, 0, 0, 0.01);
		border: 1px solid white;
		position: relative;
		overflow: hidden;
	}

	.card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 6px;
		background: linear-gradient(90deg, var(--primary), var(--accent));
	}

	h1 {
		margin: 0;
		font-size: 2.25rem;
		font-weight: 800;
		background: linear-gradient(135deg, #0369a1 0%, #1e40af 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		letter-spacing: -0.025em;
	}

	p {
		color: #64748b;
		margin: 0.75rem 0 2.5rem 0;
		font-size: 1.1rem;
	}

	.btn-opcion {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		background: linear-gradient(
			135deg,
			var(--primary) 0%,
			var(--primary-dark) 100%
		);
		color: white;
		text-decoration: none;
		padding: 1.25rem 2rem;
		border-radius: 1rem;
		font-weight: 600;
		font-size: 1.125rem;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		box-shadow: 0 4px 6px -1px rgba(14, 165, 233, 0.2);
		position: relative;
		overflow: hidden;
	}

	.btn-opcion::after {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(56, 189, 248, 0.2),
			transparent
		);
		transform: translateX(-100%);
		transition: 0.5s;
	}

	.btn-opcion:hover::after {
		transform: translateX(100%);
	}

	.btn-opcion:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 15px -3px rgba(14, 165, 233, 0.3);
	}

	.btn-opcion .icon {
		font-size: 1.5rem;
		background: rgba(255, 255, 255, 0.2);
		padding: 0.25rem;
		border-radius: 0.5rem;
	}
</style>
