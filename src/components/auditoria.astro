---
import background from "../assets/background.svg";
---

<div class="container pt-3">
    <div>
        <a href="/" class="btn btn-outline-secondary btn-sm mb-3">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-arrow-left me-1"
                viewBox="0 0 16 16"
            >
                <path
                    fill-rule="evenodd"
                    d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"
                ></path>
            </svg>
            Volver a Menú
        </a>
    </div>
</div>

<div
    style={`background-image: url(${background.src}); background-size: cover; background-attachment: fixed; filter: blur(100px); position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;`}
>
</div>

<main class="container-fluid d-flex flex-column align-items-center p-0 min-vh-100">
    <section class="container mt-5 p-3">
        
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
            <div class="d-flex align-items-center">
                <h1 class="h2 text-primary fw-bold me-2 mb-0">Pistas de Auditoría</h1>
                <i class="bi bi-shield-lock-fill text-secondary fs-2"></i>
            </div>
            <div class="d-flex gap-2">
                <button
                    id="btnExportarPDF"
                    class="btn btn-danger d-flex align-items-center"
                >
                    <i class="bi bi-file-pdf-fill me-2"></i> Exportar PDF
                </button>
                <button
                    id="btnActualizar"
                    class="btn btn-outline-primary d-flex align-items-center"
                >
                    <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
                </button>
            </div>
        </div>

        <!-- Estadísticas Rápidas -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center border-primary">
                    <div class="card-body">
                        <i class="bi bi-journal-text text-primary fs-1"></i>
                        <h3 class="mt-2 mb-0" id="totalRegistros">0</h3>
                        <p class="text-muted mb-0">Total Registros</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center border-success">
                    <div class="card-body">
                        <i class="bi bi-eye-fill text-success fs-1"></i>
                        <h3 class="mt-2 mb-0" id="totalVistas">0</h3>
                        <p class="text-muted mb-0">Visualizaciones</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center border-warning">
                    <div class="card-body">
                        <i class="bi bi-pencil-square text-warning fs-1"></i>
                        <h3 class="mt-2 mb-0" id="totalModificaciones">0</h3>
                        <p class="text-muted mb-0">Modificaciones</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center border-info">
                    <div class="card-body">
                        <i class="bi bi-people-fill text-info fs-1"></i>
                        <h3 class="mt-2 mb-0" id="totalUsuarios">0</h3>
                        <p class="text-muted mb-0">Usuarios Activos</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filtros -->
        <div class="card mb-3">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="bi bi-funnel-fill me-2"></i>Filtros de Búsqueda
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Usuario</label>
                        <input
                            type="text"
                            id="filtroUsuario"
                            class="form-control"
                            placeholder="Buscar por usuario..."
                        />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Acción</label>
                        <select id="filtroAccion" class="form-select">
                            <option value="">Todas</option>
                            <option value="LOGIN">LOGIN</option>
                            <option value="LOGOUT">LOGOUT</option>
                            <option value="VIEW">VIEW</option>
                            <option value="CREATE">CREATE</option>
                            <option value="UPDATE">UPDATE</option>
                            <option value="DELETE">DELETE</option>
                            <option value="EXPORT">EXPORT</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha Inicio</label>
                        <input
                            type="date"
                            id="filtroFechaInicio"
                            class="form-control"
                        />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha Fin</label>
                        <input
                            type="date"
                            id="filtroFechaFin"
                            class="form-control"
                        />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12 d-flex gap-2">
                        <button id="btnAplicarFiltros" class="btn btn-primary">
                            <i class="bi bi-search me-1"></i> Buscar
                        </button>
                        <button id="btnLimpiarFiltros" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Limpiar Filtros
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Auditoría -->
        <div class="table-responsive shadow-sm rounded-3">
            <table class="table table-striped table-hover align-middle table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" style="width: 50px;">#</th>
                        <th scope="col">Usuario</th>
                        <th scope="col">Acción</th>
                        <th scope="col">Función</th>
                        <th scope="col">Descripción</th>
                        <th scope="col">IP</th>
                        <th scope="col">Fecha/Hora</th>
                    </tr>
                </thead>
                <tbody id="auditoriaTableBody">
                    <tr>
                        <td colspan="7" class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        <div id="paginacion" class="d-flex justify-content-center align-items-center mt-3">
        </div>
    </section>
</main>

<!-- Modal de Detalles -->
<div class="modal fade" id="detallesModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    Detalles de Auditoría
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <strong>ID:</strong>
                        <p id="detalle-id" class="mb-0">-</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Usuario:</strong>
                        <p id="detalle-usuario" class="mb-0">-</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Acción:</strong>
                        <p id="detalle-accion" class="mb-0">-</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Función:</strong>
                        <p id="detalle-funcion" class="mb-0">-</p>
                    </div>
                    <div class="col-12 mb-3">
                        <strong>Descripción:</strong>
                        <p id="detalle-descripcion" class="mb-0">-</p>
                    </div>
                    <div class="col-12 mb-3">
                        <strong>Observación:</strong>
                        <p id="detalle-observacion" class="mb-0">-</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>IP:</strong>
                        <p id="detalle-ip" class="mb-0">-</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Fecha/Hora:</strong>
                        <p id="detalle-fecha" class="mb-0">-</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    import { initAuditoria } from "../scripts/auditoria";

    document.addEventListener("DOMContentLoaded", () => {
        initAuditoria();
    });
</script>

<style>
    .badge-action {
        font-size: 0.75rem;
        padding: 0.35em 0.65em;
    }

    .table tbody tr {
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .table tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.1) !important;
    }

    .card {
        transition: transform 0.2s;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
</style>