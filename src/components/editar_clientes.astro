                                        type="text"
                                        class="form-control"
                                        id="cedula"
                                        placeholder="Número de Cédula"
                                        value=""
                                    />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label for="cliNombre" class="form-label"
                                    >Nombre</label
                                >
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            fill="currentColor"
                                            class="bi bi-person-fill"
                                            viewBox="0 0 16 16"
                                        >
                                            <path
                                                d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"
                                            ></path>
                                        </svg>
                                    </span>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="cliNombre"
                                        placeholder="Nombre completo del cliente"
                                        value=""
                                    />
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label for="fechaNacimiento" class="form-label"
                                    >Fecha de Nacimiento</label
                                >
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            fill="currentColor"
                                            class="bi bi-calendar-date-fill"
                                            viewBox="0 0 16 16"
                                        >
                                            <path
                                                d="M4 .5a.5.5 0 0 0-1 0V1H2a2 2 0 0 0-2 2v1h16V3a2 2 0 0 0-2-2h-1V.5a.5.5 0 0 0-1 0V1H4zM16 14V5H0v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2m-6.666-4.815a1 1 0 1 0-1.732.946l.654.664H8c1.397 0 2.457-1.157 2.228-2.613a2 2 0 0 0-1.894-1.894c-1.456-.23-2.613.83-2.613 2.228 0 1.25.9 2.115 2.115 2.115h.664l.654-.664"
                                            ></path>
                                        </svg>
                                    </span>
                                    <input
                                        type="date"
                                        class="form-control"
                                        id="fechaNacimiento"
                                        value=""
                                    />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label for="tipoCliente" class="form-label"
                                    >Tipo de Cliente</label
                                >
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            fill="currentColor"
                                            class="bi bi-person-check-fill"
                                            viewBox="0 0 16 16"
                                        >
                                            <path
                                                d="M15.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L12.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"
                                            ></path>
                                            <path
                                                d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"
                                            ></path>
                                        </svg>
                                    </span>
                                    <select
                                        class="form-select"
                                        id="tipoCliente"
                                        name="tic_id_tipoc"
                                    >
                                        <option value="" selected disabled
                                            >Seleccione un tipo</option
                                        >
                                        <option value="1">Contado</option>
                                        <option value="2">Crédito</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h5 class="mb-3 text-primary">Contacto y Ubicación</h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="cliTelefono" class="form-label"
                                    >Teléfono</label
                                >
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            fill="currentColor"
                                            class="bi bi-phone"
                                            viewBox="0 0 16 16"
                                        >
                                            <path
                                                d="M11 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM5 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"
                                            ></path>
                                            <path
                                                d="M8 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2"
                                            ></path>
                                        </svg>
                                    </span>
                                    <input
                                        type="tel"
                                        class="form-control"
                                        id="cliTelefono"
                                        name="cli_telefono"
                                        placeholder="Número de teléfono"
                                        value=""
                                    />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label for="email" class="form-label"
                                    >E-mail</label
                                >
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            fill="currentColor"
                                            class="bi bi-envelope-fill"
                                            viewBox="0 0 16 16"
                                        >
                                            <path
                                                d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.027c.045.165.234.3.494.305h15.012c.261 0 .45-.14.494-.305V4.697l-7.25 4.4z"
                                            ></path>
                                        </svg>
                                    </span>
                                    <input
                                        type="email"
                                        class="form-control"
                                        id="email"
                                        name="cli_email"
                                        placeholder="Correo electrónico"
                                        value=""
                                    />
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <label for="cliDireccion" class="form-label"
                                    >Dirección</label
                                >
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            fill="currentColor"
                                            class="bi bi-geo-alt-fill"
                                            viewBox="0 0 16 16"
                                        >
                                            <path
                                                d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"
                                            ></path>
                                        </svg>
                                    </span>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="cliDireccion"
                                        name="cli_direccion"
                                        placeholder="Dirección completa del cliente"
                                        value=""
                                    />
                                </div>
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button
                                type="submit"
                                class="btn btn-primary btn-lg"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="16"
                                    height="16"
                                    fill="currentColor"
                                    class="bi bi-save-fill me-2"
                                    viewBox="0 0 16 16"
                                >
                                    <path
                                        d="M8.5 1.5A1.5 1.5 0 0 1 10 0h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h4a.5.5 0 0 1 .5.5V5h-2A1.5 1.5 0 0 0 4 6.5v4.5A1.5 1.5 0 0 0 5.5 12h5a1.5 1.5 0 0 0 1.5-1.5V6.5A1.5 1.5 0 0 0 10.5 5h-2z"
                                    ></path>
                                </svg>
                                Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const API_URL = "http://127.0.0.1:5055/api/Clientes";
    const params = new URLSearchParams(window.location.search);
    const cedula = params.get("id");

    const form = document.querySelector("form") as HTMLFormElement;

    if (!cedula) {
        alert("No se especificó un cliente para editar");
        window.location.href = "/clientes";
    }

    // Cargar datos
    document.addEventListener("DOMContentLoaded", async () => {
        try {
            const response = await fetch(`${API_URL}/${cedula}`);
            if (!response.ok) throw new Error("Cliente no encontrado");

            const data = await response.json();

            // Mapear datos al formulario
            (document.getElementById("cedula") as HTMLInputElement).value =
                data.cliCedula || "";
            // Cedula es PK, mejor hacerla readonly
            (document.getElementById("cedula") as HTMLInputElement).readOnly =
                true;

            (document.getElementById("cliNombre") as HTMLInputElement).value =
                data.cliNombre || "";

            if (data.cliFechaNacimiento) {
                (
                    document.getElementById(
                        "fechaNacimiento",
                    ) as HTMLInputElement
                ).value = data.cliFechaNacimiento.split("T")[0];
            }

            (
                document.getElementById("tipoCliente") as HTMLSelectElement
            ).value = data.ticIdTipoc?.toString() || "";
            (document.getElementById("cliTelefono") as HTMLInputElement).value =
                data.cliTelefono || "";
            (document.getElementById("email") as HTMLInputElement).value =
                data.cliEmail || "";
            (
                document.getElementById("cliDireccion") as HTMLInputElement
            ).value = data.cliDireccion || "";
        } catch (error) {
            console.error(error);
            alert("Error al cargar datos del cliente");
            window.location.href = "/clientes";
        }
    });

    // Guardar cambios
    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const formData = new FormData(form);

        const getValue = (key: string) => {
            const val = formData.get(key)?.toString().trim();
            return val === "" ? null : val;
        };

        const cliente = {
            cliCedula: cedula, // Usar el original
            cliNombre: getValue("cli_nombre"), // Hay que asegurar que los inputs tengan name="cli_nombre" si se usa formData.get
            // Como arriba NO puse names en todos los inputs, mejor selecciono por ID 
            // Pero voy a asumir que agregamos los names en el replaceContent de arriba
            cliFechaNacimiento:
                (document.getElementById("fechaNacimiento") as HTMLInputElement)
                    .value || null,
            ticIdTipoc: parseInt(
                (document.getElementById("tipoCliente") as HTMLSelectElement)
                    .value || "0",
            ),
            cliDireccion:
                (document.getElementById("cliDireccion") as HTMLInputElement)
                    .value || null,
            cliTelefono:
                (document.getElementById("cliTelefono") as HTMLInputElement)
                    .value || null,
            cliEmail:
                (document.getElementById("email") as HTMLInputElement).value ||
                null,

            // Campos requeridos por el modelo para el PUT (si el backend valida todo el objeto)
            cliEstado: true, // Asumimos que sigue activo si se edita
        };

        // Arreglar nombres si usé getElementById
        // @ts-ignore
        cliente.cliNombre = (
            document.getElementById("cliNombre") as HTMLInputElement
        ).value;

        try {
            const response = await fetch(`${API_URL}/${cedula}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(cliente),
            });

            if (response.ok || response.status === 204) {
                alert("Cliente actualizado correctamente");
                window.location.href = "/clientes";
            } else {
                const text = await response.text();
                alert("Error al actualizar: " + text);
            }
        } catch (e) {
            console.error(e);
            alert("Error de conexión");
        }
    });
</script>
