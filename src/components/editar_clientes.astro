
<div class="container pt-3">
    <div>
        <a href="clientes" class="btn btn-outline-secondary btn-sm mb-3">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-arrow-left me-1"
                viewBox="0 0 16 16"
            >
                <path
                    fill-rule="evenodd"
                    d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"
                ></path>
            </svg>
            Volver a Clientes
        </a>
    </div>
</div>

<div class="container pb-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="text-center font-weight-light my-2">
                        Editar Cliente
                    </h3>
                </div>
                <div class="card-body">
                    <form>
                        <h5 class="mb-3 text-primary">Información Personal</h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="cedula" class="form-label"
                                    >Cédula</label
                                >
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            fill="currentColor"
                                            class="bi bi-person-vcard-fill"
                                            viewBox="0 0 16 16"
                                        >
                                            <path
                                                d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm9 1.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 0-1h-4a.5.5 0 0 0-.5.5M9 8a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 0-1h-4A.5.5 0 0 0 9 8m1 2.5a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 0-1h-3a.5.5 0 0 0-.5.5m-1 2C9 10.567 7.21 9 5 9c-2.086 0-3.8 1.398-3.984 3.181A1 1 0 0 0 2 13h6.96q.04-.245.04-.5M7 6a2 2 0 1 0-4 0 2 2 0 0 0 4 0"
                                            ></path>
                                        </svg>
                                    </span>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="cedula"
                                        placeholder="Número de Cédula"
                                        value=""
                                    />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label for="cliNombre" class="form-label"
                                    >Nombre</label
                                >
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            fill="currentColor"
                                            class="bi bi-person-fill"
                                            viewBox="0 0 16 16"
                                        >
                                            <path
                                                d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"
                                            ></path>
                                        </svg>
                                    </span>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="cliNombre"
                                        placeholder="Nombre completo del cliente"
                                        value=""
                                    />
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label for="fechaNacimiento" class="form-label"
                                    >Fecha de Nacimiento</label
                                >
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            fill="currentColor"
                                            class="bi bi-calendar-date-fill"
                                            viewBox="0 0 16 16"
                                        >
                                            <path
                                                d="M4 .5a.5.5 0 0 0-1 0V1H2a2 2 0 0 0-2 2v1h16V3a2 2 0 0 0-2-2h-1V.5a.5.5 0 0 0-1 0V1H4zM16 14V5H0v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2m-6.666-4.815a1 1 0 1 0-1.732.946l.654.664H8c1.397 0 2.457-1.157 2.228-2.613a2 2 0 0 0-1.894-1.894c-1.456-.23-2.613.83-2.613 2.228 0 1.25.9 2.115 2.115 2.115h.664l.654-.664"
                                            ></path>
                                        </svg>
                                    </span>
                                    <input
                                        type="date"
                                        class="form-control"
                                        id="fechaNacimiento"
                                        value=""
                                    />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label for="tipoCliente" class="form-label"
                                    >Tipo de Cliente</label
                                >
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            fill="currentColor"
                                            class="bi bi-credit-card-2-front-fill"
                                            viewBox="0 0 16 16"
                                        >
                                            <path
                                                d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2.5 3.5a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1zm4.414-2H14a.5.5 0 0 0 0-1H6.914a.5.5 0 0 0 0 1"
                                            ></path>
                                        </svg>
                                    </span>
                                    <select
                                        class="form-select"
                                        id="tipoCliente"
                                    >
                                        <option value="" selected disabled
                                            >Seleccione un tipo</option
                                        >
                                        <option value="contado">Contado</option>
                                        <option value="credito">Crédito</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h5 class="mb-3 text-primary">Contacto y Ubicación</h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="cliTelefono" class="form-label"
                                    >Teléfono</label
                                >
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            fill="currentColor"
                                            class="bi bi-phone"
                                            viewBox="0 0 16 16"
                                        >
                                            <path
                                                d="M11 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM5 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"
                                            ></path>
                                            <path
                                                d="M8 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2"
                                            ></path>
                                        </svg>
                                    </span>
                                    <input
                                        type="tel"
                                        class="form-control"
                                        id="cliTelefono"
                                        placeholder="Número de teléfono"
                                        value=""
                                    />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label for="email" class="form-label"
                                    >E-mail</label
                                >
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            fill="currentColor"
                                            class="bi bi-envelope-fill"
                                            viewBox="0 0 16 16"
                                        >
                                            <path
                                                d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.027c.045.165.234.3.494.305h15.012c.261 0 .45-.14.494-.305V4.697l-7.25 4.4z"
                                            ></path>
                                        </svg>
                                    </span>
                                    <input
                                        type="email"
                                        class="form-control"
                                        id="email"
                                        placeholder="Correo electrónico"
                                        value=""
                                    />
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <label for="cliDireccion" class="form-label"
                                    >Dirección</label
                                >
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            fill="currentColor"
                                            class="bi bi-house-fill"
                                            viewBox="0 0 16 16"
                                        >
                                            <path
                                                d="M8.707 1.5a1 1 0 0 0-1.414 0L.5 7.071V14.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5V7.071z"
                                            ></path>
                                        </svg>
                                    </span>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="cliDireccion"
                                        placeholder="Dirección completa del cliente"
                                        value=""
                                    />
                                </div>
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button
                                type="submit"
                                class="btn btn-primary btn-lg"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="16"
                                    height="16"
                                    fill="currentColor"
                                    class="bi bi-save-fill me-2"
                                    viewBox="0 0 16 16"
                                >
                                    <path
                                        d="M8.5 1.5A1.5 1.5 0 0 1 10 0h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h4a.5.5 0 0 1 .5.5V5h-2A1.5 1.5 0 0 0 4 6.5v4.5A1.5 1.5 0 0 0 5.5 12h5a1.5 1.5 0 0 0 1.5-1.5V6.5A1.5 1.5 0 0 0 10.5 5h-2z"
                                    ></path>
                                </svg>
                                Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
