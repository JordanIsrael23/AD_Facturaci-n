---
import background from "../assets/background.svg";
---

<div class="container pt-3">
    <div>
        <a href="/" class="btn btn-outline-secondary btn-sm mb-3">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-arrow-left me-1"
                viewBox="0 0 16 16"
            >
                <path
                    fill-rule="evenodd"
                    d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"
                ></path>
            </svg>
            Volver a Menu
        </a>
    </div>
</div>
<div
    style={`background-image: url(${background.src}); background-size: cover; background-attachment: fixed; filter: blur(100px); position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;`}
>
</div>

<main
    class="container-fluid d-flex flex-column align-items-center p-0 min-vh-100"
>
    <section class="container mt-5 p-3">
        <div
            class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2"
        >
            <div class="d-flex align-items-center">
                <h1 class="h2 text-primary fw-bold me-2 mb-0">Clientes</h1>
                <i class="bi bi-people-fill text-secondary fs-2"></i>
            </div>

            <div class="d-flex gap-2">
                <button
                    id="btnReporteGlobal"
                    class="btn btn-dark d-flex align-items-center"
                >
                    <i class="bi bi-file-earmark-bar-graph-fill me-2"></i> Reporte
                    Global
                </button>
                <a
                    href="/restablecer-clientes"
                    class="btn btn-outline-primary d-flex align-items-center"
                >
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Restablecer
                    Clientes
                </a>
                <a
                    href="/crear-cliente"
                    class="btn btn-primary d-flex align-items-center"
                >
                    <i class="bi bi-plus-lg me-1"></i> Nuevo Cliente
                </a>
            </div>
        </div>
        <!-- FILTROS -->
        <div class="row mb-3 justify-content-center">
            <div class="col-md-4">
                <div class="input-group">
                    <button
                        type="button"
                        class="input-group-text btn btn-outline-secondary btnFiltro"
                        data-for="filtroCedula"
                    >
                        <i class="bi bi-funnel iconoFiltro"></i>
                    </button>
                    <input
                        type="text"
                        id="filtroCedula"
                        class="form-control"
                        placeholder="Filtrar por cédula"
                    />
                </div>
            </div>

            <div class="col-md-4">
                <div class="input-group">
                    <button
                        type="button"
                        class="input-group-text btn btn-outline-secondary btnFiltro"
                        data-for="filtroNombre"
                    >
                        <i class="bi bi-funnel iconoFiltro"></i>
                    </button>

                    <input
                        type="text"
                        id="filtroNombre"
                        class="form-control"
                        placeholder="Filtrar por nombre"
                    />
                </div>
            </div>
        </div>

        <div class="table-responsive shadow-sm rounded-3">
            <table
                class="table table-striped table-hover align-middle table-bordered"
            >
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Acciones</th>
                        <th scope="col">Cédula</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Fecha de Nacimiento</th>
                        <th scope="col">Tipo Cliente</th>
                        <th scope="col">Dirección</th>
                        <th scope="col">Teléfono</th>
                        <th scope="col">Email</th>
                        <th scope="col">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <div class="d-flex gap-2">
                                <a
                                    href="editar_clientes"
                                    class="btn btn-sm btn-warning me-2 d-inline-flex align-items-center"
                                >
                                    <i class="bi bi-pencil-square me-1"></i> Editar
                                </a>
                                <button
                                    type="button"
                                    class="btn btn-sm btn-danger d-inline-flex align-items-center"
                                    data-bs-toggle="modal"
                                    data-bs-target="#confirmDeleteModal"
                                >
                                    <i class="bi bi-trash me-1"></i> Desactivar
                                </button>
                            </div>
                        </td>
                        <td>1710000000</td>
                        <td>Juan Pérez</td>
                        <td>1990-05-15</td>
                        <td>Credito</td>
                        <td>Av. Principal #101</td>
                        <td>0991234567</td>
                        <td>juan.perez@email.com</td>
                        <td>
                            <span class="badge text-bg-success">Activo</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div
            id="paginacion"
            class="d-flex justify-content-center align-items-center mt-3"
        >
        </div>
    </section>
</main>

<div
    class="modal fade"
    id="confirmDeleteModal"
    tabindex="-1"
    aria-labelledby="confirmDeleteModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-danger border-3">
            <div class="modal-header bg-danger text-white">
                <h5
                    class="modal-title d-flex align-items-center"
                    id="confirmDeleteModalLabel"
                >
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
                    Confirmar desactivación
                </h5>
                <button
                    type="button"
                    class="btn-close btn-close-white"
                    data-bs-dismiss="modal"
                    aria-label="Cerrar"></button>
            </div>

            <div class="modal-body text-center p-4">
                <p class="lead text-dark">
                    ¿Estás seguro que deseas desactivar el cliente **Nombre**?
                </p>
                <p class="text-muted small">Este Cliente sera desactivado.</p>
            </div>

            <div class="modal-footer justify-content-center">
                <button
                    type="button"
                    class="btn btn-danger d-inline-flex align-items-center"
                    id="confirmDeleteBtn"
                >
                    <i class="bi bi-check-circle-fill me-1"></i> Aceptar y Desactivar
                </button>

                <button
                    type="button"
                    class="btn btn-outline-secondary d-inline-flex align-items-center"
                    data-bs-dismiss="modal"
                >
                    <i class="bi bi-x-circle-fill me-1"></i> Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ver Cliente -->
<div
    class="modal fade"
    id="viewClienteModal"
    tabindex="-1"
    aria-labelledby="viewClienteModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-primary text-white">
                <h5
                    class="modal-title d-flex align-items-center"
                    id="viewClienteModalLabel"
                >
                    <i class="bi bi-person-vcard-fill me-2 fs-4"></i>
                    Detalles del Cliente
                </h5>
                <button
                    type="button"
                    class="btn-close btn-close-white"
                    data-bs-dismiss="modal"
                    aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Info Cliente -->
                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <h6
                            class="text-primary fw-bold text-uppercase small mb-3 border-bottom pb-2"
                        >
                            Información Personal
                        </h6>
                        <p class="mb-1">
                            <strong>Nombre:</strong>
                            <span id="modalCliNombre"></span>
                        </p>
                        <p class="mb-1">
                            <strong>Cédula:</strong>
                            <span id="modalCliCedula" class="font-monospace"
                            ></span>
                        </p>
                        <p class="mb-1">
                            <strong>Fecha Nacimiento:</strong>
                            <span id="modalCliFechaNac"></span>
                        </p>
                        <p class="mb-1">
                            <strong>Tipo:</strong>
                            <span id="modalCliTipo"></span>
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <h6
                            class="text-primary fw-bold text-uppercase small mb-3 border-bottom pb-2"
                        >
                            Contacto
                        </h6>
                        <p class="mb-1">
                            <strong>Email:</strong>
                            <span id="modalCliEmail"></span>
                        </p>
                        <p class="mb-1">
                            <strong>Teléfono:</strong>
                            <span id="modalCliTelefono"></span>
                        </p>
                        <p class="mb-1">
                            <strong>Dirección:</strong>
                            <span id="modalCliDireccion"></span>
                        </p>
                        <p class="mb-1">
                            <strong>Estado:</strong>
                            <span id="modalCliEstado"></span>
                        </p>
                    </div>
                </div>

                <!-- Historial Facturas -->
                <h6
                    class="text-primary fw-bold text-uppercase small mb-3 border-bottom pb-2"
                >
                    <i class="bi bi-receipt me-1"></i> Historial de Facturas
                </h6>
                <div class="table-responsive rounded border">
                    <table
                        class="table table-striped table-hover mb-0 text-center align-middle"
                    >
                        <thead
                            class="table-light text-secondary small text-uppercase"
                        >
                            <tr>
                                <th># Factura</th>
                                <th>Fecha</th>
                                <th>Total</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody id="modalCliFacturasBody">
                            <!-- JS populated -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button
                    type="button"
                    class="btn btn-secondary d-flex align-items-center"
                    data-bs-dismiss="modal"
                >
                    <i class="bi bi-x-lg me-1"></i> Cerrar
                </button>
                <button
                    type="button"
                    class="btn btn-info text-white d-flex align-items-center"
                    id="modalBtnPdf"
                >
                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> Generar PDF
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Reporte Global (NUEVO) -->
<div
    class="modal fade"
    id="reporteGlobalModal"
    tabindex="-1"
    aria-labelledby="reporteGlobalModalLabel"
    aria-hidden="true"
>
    <div
        class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"
    >
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-dark text-white">
                <h5
                    class="modal-title d-flex align-items-center"
                    id="reporteGlobalModalLabel"
                >
                    <i class="bi bi-file-earmark-bar-graph-fill me-2 fs-4"></i>
                    Vista Previa: Reporte General de Clientes
                </h5>
                <button
                    type="button"
                    class="btn-close btn-close-white"
                    data-bs-dismiss="modal"
                    aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <div
                    class="alert alert-info d-flex align-items-center"
                    role="alert"
                >
                    <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                    <div>
                        Este reporte incluye todos los clientes registrados y su
                        actividad de facturación. Revise la lista antes de
                        generar el PDF final.
                    </div>
                </div>

                <div class="table-responsive rounded border">
                    <table
                        class="table table-striped table-hover mb-0 text-center align-middle"
                    >
                        <thead
                            class="table-dark text-white small text-uppercase"
                        >
                            <tr>
                                <th>Cédula</th>
                                <th>Nombre</th>
                                <th>Tipo</th>
                                <th>Facturas (Cant.)</th>
                                <th>Total Facturado</th>
                            </tr>
                        </thead>
                        <tbody id="globalReportBody">
                            <!-- JS populated -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal"
                >
                    Cerrar
                </button>
                <button
                    type="button"
                    class="btn btn-success d-flex align-items-center px-4"
                    id="btnDownloadGlobalPdf"
                >
                    <i class="bi bi-download me-2"></i> Descargar Reporte Completo
                    (PDF)
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    import { initClientes } from "../scripts/clientes";

    // Astro ejecutará esto en el navegador
    document.addEventListener("DOMContentLoaded", () => {
        initClientes();
    });
</script>
