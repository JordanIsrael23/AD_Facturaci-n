---
import background from "../assets/background.svg";
---

<div class="container pt-3">
    <div>
        <a href="/" class="btn btn-outline-secondary btn-sm mb-3">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-arrow-left me-1"
                viewBox="0 0 16 16"
            >
                <path
                    fill-rule="evenodd"
                    d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"
                ></path>
            </svg>
            Volver a Menu
        </a>
    </div>
</div>
<div
    style={`background-image: url(${background.src}); background-size: cover; background-attachment: fixed; filter: blur(100px); position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;`}
>
</div>

<main
    class="container-fluid d-flex flex-column align-items-center p-0 min-vh-100"
>
    <section class="container mt-5 p-3">
        <div
            class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2"
        >
            <div class="d-flex align-items-center">
                <h1 class="h2 text-primary fw-bold me-2 mb-0">Clientes</h1>
                <i class="bi bi-people-fill text-secondary fs-2"></i>
            </div>

            <div class="d-flex gap-2">
                <a
                    href="/restablecer-clientes"
                    class="btn btn-outline-primary d-flex align-items-center"
                >
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Restablecer
                    Clientes
                </a>
                <a
                    href="/crear-cliente"
                    class="btn btn-primary d-flex align-items-center"
                >
                    <i class="bi bi-plus-lg me-1"></i> Nuevo Cliente
                </a>
            </div>
        </div>
        <!-- FILTROS -->
        <div class="row mb-3 justify-content-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            fill="currentColor"
                            class="bi bi-funnel"
                            viewBox="0 0 16 16"
                        >
                            <path
                                d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5zm1 .5v1.308l4.372 4.858A.5.5 0 0 1 7 8.5v5.306l2-.666V8.5a.5.5 0 0 1 .128-.334L13.5 3.308V2z"
                            ></path>
                        </svg>
                    </span>
                    <input
                        type="text"
                        id="filtroCedula"
                        class="form-control"
                        placeholder="Filtrar por cédula"
                    />
                </div>
            </div>

            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            fill="currentColor"
                            class="bi bi-funnel"
                            viewBox="0 0 16 16"
                        >
                            <path
                                d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5zm1 .5v1.308l4.372 4.858A.5.5 0 0 1 7 8.5v5.306l2-.666V8.5a.5.5 0 0 1 .128-.334L13.5 3.308V2z"
                            ></path>
                        </svg>
                    </span>
                    <input
                        type="text"
                        id="filtroNombre"
                        class="form-control"
                        placeholder="Filtrar por nombre"
                    />
                </div>
            </div>
        </div>

        <div class="table-responsive shadow-sm rounded-3">
            <table
                class="table table-striped table-hover align-middle table-bordered"
            >
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Acciones</th>
                        <th scope="col">Cédula</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Fecha de Nacimiento</th>
                        <th scope="col">Tipo Cliente</th>
                        <th scope="col">Dirección</th>
                        <th scope="col">Teléfono</th>
                        <th scope="col">Email</th>
                        <th scope="col">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <a
                                href="editar_clientes"
                                class="btn btn-sm btn-warning me-2 d-inline-flex align-items-center"
                            >
                                <i class="bi bi-pencil-square me-1"></i> Editar
                            </a>
                            <button
                                type="button"
                                class="btn btn-sm btn-danger d-inline-flex align-items-center"
                                data-bs-toggle="modal"
                                data-bs-target="#confirmDeleteModal"
                            >
                                <i class="bi bi-trash me-1"></i> Eliminar
                            </button>
                        </td>
                        <td>1710000000</td>
                        <td>Juan Pérez</td>
                        <td>1990-05-15</td>
                        <td>Credito</td>
                        <td>Av. Principal #101</td>
                        <td>0991234567</td>
                        <td>juan.perez@email.com</td>
                        <td>
                            <span class="badge text-bg-success">Activo</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</main>

<div
    class="modal fade"
    id="confirmDeleteModal"
    tabindex="-1"
    aria-labelledby="confirmDeleteModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-danger border-3">
            <div class="modal-header bg-danger text-white">
                <h5
                    class="modal-title d-flex align-items-center"
                    id="confirmDeleteModalLabel"
                >
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
                    Confirmar Eliminación
                </h5>
                <button
                    type="button"
                    class="btn-close btn-close-white"
                    data-bs-dismiss="modal"
                    aria-label="Cerrar"></button>
            </div>

            <div class="modal-body text-center p-4">
                <p class="lead text-dark">
                    ¿Estás seguro que deseas eliminar el cliente **Nombre**?
                </p>
                <p class="text-muted small">
                    Esta acción no se puede deshacer.
                </p>
            </div>

            <div class="modal-footer justify-content-center">
                <button
                    type="button"
                    class="btn btn-danger d-inline-flex align-items-center"
                    id="confirmDeleteBtn"
                >
                    <i class="bi bi-check-circle-fill me-1"></i> Aceptar y Eliminar
                </button>

                <button
                    type="button"
                    class="btn btn-outline-secondary d-inline-flex align-items-center"
                    data-bs-dismiss="modal"
                >
                    <i class="bi bi-x-circle-fill me-1"></i> Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    declare const bootstrap: any;
    const API_URL = "http://127.0.0.1:5055/api/Clientes";
    let clienteIdToDelete: string | null = null;
    let clientesData: any[] = [];

    document.addEventListener("DOMContentLoaded", () => {
        loadClientes();
        setupDeleteModal();
        document
            .getElementById("filtroCedula")
            ?.addEventListener("input", aplicarFiltros);
        document
            .getElementById("filtroNombre")
            ?.addEventListener("input", aplicarFiltros);
    });

    async function loadClientes() {
        const tbody = document.querySelector("tbody");
        if (!tbody) return;

        tbody.innerHTML =
            '<tr><td colspan="9" class="text-center">Cargando clientes...</td></tr>';

        try {
            const response = await fetch(`${API_URL}/activos`);
            if (!response.ok) throw new Error("Error al cargar clientes");

            const data = await response.json();
            //const clientes = data.data || [];
            const clientes = data.data || [];
            clientesData = clientes;

            if (clientes.length === 0) {
                tbody.innerHTML =
                    '<tr><td colspan="9" class="text-center">No hay clientes activos registrados.</td></tr>';
                return;
            }

            tbody.innerHTML = clientes
                .map(
                    (c: any) => `
                <tr>
                    <td>
                        <a href="editar_clientes?id=${c.cliCedula}" class="btn btn-sm btn-warning me-2 d-inline-flex align-items-center">
                            <i class="bi bi-pencil-square me-1"></i> Editar
                        </a>
                        <button 
                            type="button" 
                            class="btn btn-sm btn-danger d-inline-flex align-items-center btn-delete" 
                            data-cedula="${c.cliCedula}"
                            data-nombre="${c.cliNombre}"
                        >
                            <i class="bi bi-trash me-1"></i> Eliminar
                        </button>
                    </td>
                    <td>${c.cliCedula}</td>
                    <td>${c.cliNombre}</td>
                    <td>${c.cliFechaNacimiento || c.CliFechaNacimiento ? String(c.cliFechaNacimiento || c.CliFechaNacimiento).split("T")[0] : "N/A"}</td>
                    <td>${c.tipoCliente && c.tipoCliente.ticDescripcion ? c.tipoCliente.ticDescripcion : c.ticIdTipoc === 1 ? "Contado" : "Crédito"}</td>
                    <td>${c.cliDireccion || ""}</td>
                    <td>${c.cliTelefono || ""}</td>
                    <td>${c.cliEmail || ""}</td>
                    <td><span class="badge text-bg-success">Activo</span></td>
                </tr>
            `,
                )
                .join("");

            attachDeleteListeners();
        } catch (error: any) {
            console.error("Error:", error);
            tbody.innerHTML = `<tr><td colspan="9" class="text-center text-danger">Error al cargar datos. Asegúrate que la API esté corriendo.</td></tr>`;
        }
    }

    function renderClientes(clientes: any[]) {
        const tbody = document.querySelector("tbody");
        if (!tbody) return;

        if (clientes.length === 0) {
            tbody.innerHTML =
                '<tr><td colspan="9" class="text-center">No hay resultados.</td></tr>';
            return;
        }

        tbody.innerHTML = clientes
            .map(
                (c: any) => `
        <tr>
            <td>
                <a href="editar_clientes?id=${c.cliCedula}" class="btn btn-sm btn-warning me-2">
                    <i class="bi bi-pencil-square"></i> Editar
                </a>
                <button 
                    class="btn btn-sm btn-danger btn-delete"
                    data-cedula="${c.cliCedula}"
                    data-nombre="${c.cliNombre}">
                    <i class="bi bi-trash"></i> Eliminar
                </button>
            </td>
            <td>${c.cliCedula}</td>
            <td>${c.cliNombre}</td>
            <td>${c.cliFechaNacimiento ? String(c.cliFechaNacimiento).split("T")[0] : "N/A"}</td>
            <td>${c.tipoCliente?.ticDescripcion || "N/A"}</td>
            <td>${c.cliDireccion || ""}</td>
            <td>${c.cliTelefono || ""}</td>
            <td>${c.cliEmail || ""}</td>
            <td><span class="badge text-bg-success">Activo</span></td>
        </tr>
    `,
            )
            .join("");

        attachDeleteListeners();
    }
    function aplicarFiltros() {
        const cedula = (
            document.getElementById("filtroCedula") as HTMLInputElement
        ).value.toLowerCase();

        const nombre = (
            document.getElementById("filtroNombre") as HTMLInputElement
        ).value.toLowerCase();

        const filtrados = clientesData.filter((c) => {
            const matchCedula = c.cliCedula.toString().includes(cedula);
            const matchNombre = c.cliNombre.toLowerCase().includes(nombre);

            return matchCedula && matchNombre;
        });

        renderClientes(filtrados);
    }

    function setupDeleteModal() {
        const confirmBtn = document.getElementById("confirmDeleteBtn");
        if (!confirmBtn) return;

        confirmBtn.addEventListener("click", async () => {
            if (!clienteIdToDelete) return;

            try {
                const response = await fetch(
                    `${API_URL}/${clienteIdToDelete}/estado`,
                    {
                        method: "PATCH",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({ estado: false }),
                    },
                );

                if (response.ok) {
                    // @ts-ignore
                    const modalEl =
                        document.getElementById("confirmDeleteModal");
                    // @ts-ignore
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    modal.hide();

                    loadClientes();
                } else {
                    alert("Error al eliminar cliente");
                }
            } catch (error) {
                console.error(error);
                alert("Error de conexión");
            }
        });
    }

    function attachDeleteListeners() {
        document.querySelectorAll(".btn-delete").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                // @ts-ignore
                const target = e.target.closest(".btn-delete");
                const cedula = target.getAttribute("data-cedula");
                const nombre = target.getAttribute("data-nombre");

                clienteIdToDelete = cedula;

                const modalBody = document.querySelector(
                    "#confirmDeleteModal .modal-body p.lead",
                );
                if (modalBody)
                    modalBody.innerHTML = `¿Estás seguro que deseas eliminar el cliente <strong>${nombre}</strong>?`;

                // @ts-ignore
                const modal = new bootstrap.Modal(
                    document.getElementById("confirmDeleteModal"),
                );
                modal.show();
            });
        });
    }
</script>
