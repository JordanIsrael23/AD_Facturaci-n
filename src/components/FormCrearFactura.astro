---
import background from "../assets/background.svg";
---

<div class="container pt-3">
    <a href="/facturas" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left me-1"></i> Volver a Facturas
    </a>
</div>

<div style={`background-image: url(${background.src}); background-size: cover; background-attachment: fixed; filter: blur(100px); position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;`}></div>

<main class="container">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm mt-2 mb-5">
                <div class="card-body p-4">
                    <form id="formCrearFactura" autocomplete="off">
                        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                            <h2 class="text-primary fw-bold mb-0">
                                <i class="bi bi-receipt-cutoff me-2"></i>Nueva Factura
                            </h2>
                        </div>

                       <div class="card bg-light border-0 mb-4">
                            <div class="card-body">
                                <h5 class="card-title text-secondary border-bottom pb-2 mb-3">
                                    <i class="bi bi-receipt me-2"></i>Datos de Facturación
                                </h5>
                                
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="estRuc" class="form-label fw-medium">
                                            <i class="bi bi-building me-1"></i>Establecimiento
                                        </label>
                                        <select class="form-select" id="estRuc" required>
                                            <option value="">Seleccione...</option>
                                        </select>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <label for="pemId" class="form-label fw-medium">
                                            <i class="bi bi-geo-alt me-1"></i>Punto de Emisión
                                        </label>
                                        <select class="form-select" id="pemId" required disabled>
                                            <option value="">Seleccione establecimiento...</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="tipIdTipop" class="form-label fw-medium">
                                            <i class="bi bi-wallet2 me-1"></i>Tipo de Pago
                                        </label>
                                        <select class="form-select" id="tipIdTipop" required>
                                            <option value="">Seleccione tipo pago...</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="facFechaVisual" class="form-label fw-medium">
                                            <i class="bi bi-calendar-event-fill me-1"></i>Fecha de Emisión
                                        </label>
                                        <input type="date" class="form-control bg-white" id="facFechaVisual" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card bg-light border-0 mb-4">
                            <div class="card-body">
                                <h5 class="card-title text-secondary border-bottom pb-2 mb-3">
                                    <i class="bi bi-person-vcard me-2"></i>Datos del Cliente
                                </h5>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="cliCedula" class="form-label fw-medium">
                                            <i class="bi bi-search me-1"></i>Buscar Cliente (Cédula)
                                        </label>
                                        <select class="form-select" id="cliCedula" required>
                                            <option value="">Seleccione un cliente...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="cliNombreVisual" class="form-label fw-medium">
                                            <i class="bi bi-person-fill me-1"></i>Nombre 
                                        </label>
                                        <input type="text" class="form-control bg-white" id="cliNombreVisual" readonly placeholder="Se completará autom." />
                                    </div>

                                    <div class="col-md-6">
                                        <label for="cliTipoVisual" class="form-label fw-medium">
                                            <i class="bi bi-tags-fill me-1"></i>Tipo de Cliente
                                        </label>
                                        <input type="text" class="form-control bg-white" id="cliTipoVisual" readonly placeholder="--" />
                                    </div>
                                    <div class="col-md-6">
                                        <label for="cliDireccionVisual" class="form-label fw-medium">
                                            <i class="bi bi-geo-alt-fill me-1"></i>Dirección
                                        </label>
                                        <input type="text" class="form-control bg-white" id="cliDireccionVisual" readonly placeholder="--" />
                                    </div>

                                    <div class="col-md-6">
                                        <label for="cliTelefonoVisual" class="form-label fw-medium">
                                            <i class="bi bi-telephone-fill me-1"></i>Teléfono
                                        </label>
                                        <input type="text" class="form-control bg-white" id="cliTelefonoVisual" readonly placeholder="--" />
                                    </div>
                                    <div class="col-md-6">
                                        <label for="cliEmailVisual" class="form-label fw-medium">
                                            <i class="bi bi-envelope-at-fill me-1"></i>Correo Electrónico
                                        </label>
                                        <input type="text" class="form-control bg-white" id="cliEmailVisual" readonly placeholder="--" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="text-secondary mb-0">
                                    <i class="bi bi-box-seam me-2"></i>Detalle de Productos
                                </h5>
                                <button type="button" class="btn btn-primary btn-sm" id="btnAddDetalle">
                                    <i class="bi bi-plus-lg me-1"></i> Agregar Producto
                                </button>
                            </div>

                            <div class="alert alert-info d-flex align-items-center py-2 mb-3" role="alert">
                                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                                <div class="small">
                                    La descripción, precios e impuestos se completarán automáticamente desde el inventario.
                                </div>
                            </div>

                            <div class="table-responsive bg-white border rounded">
                                <table class="table table-bordered mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-center" style="width: 80px;">Acción</th>
                                            <th style="min-width: 200px;">Producto (Nombre)</th>
                                            <th>Código</th>
                                            <th>Descripción</th>
                                            <th class="text-center">Stock</th>
                                            <th class="text-end">Costo</th>
                                            <th class="text-center" style="width: 100px;">Cantidad</th>
                                            <th class="text-center">Impuesto</th>
                                            <th class="text-end">Precio (Sin IVA)</th>
                                            <th class="text-end">Precio Total</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyDetalles">
                                        </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4 pt-3 border-top">
                            <a href="/facturas" class="btn btn-outline-secondary px-4 fw-medium">Cancelar</a>
                            <button type="submit" class="btn btn-success px-5 fw-bold d-flex align-items-center justify-content-center">
                                <i class="bi bi-save me-2"></i> Emitir Factura
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="errorModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-danger border-3">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Advertencia</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <p id="errorModalMsg" class="lead fw-medium">
                        </p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Entendido</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-success border-3">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title d-flex align-items-center">
                        <i class="bi bi-check-circle-fill me-2 fs-4"></i>
                        Factura Emitida
                    </h5>
                </div>
                <div class="modal-body text-center p-5">
                    <div class="mb-3">
                        <i class="bi bi-receipt text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h4 class="fw-bold text-success mb-3">¡Operación Exitosa!</h4>
                    <p class="lead text-dark mb-0">La factura ha sido generada y guardada correctamente.</p>
                    <p id="mensajeExitoId" class="text-muted mt-2 small"></p>
                </div>
                <div class="modal-footer justify-content-center border-0 pb-4">
                    <button 
                        type="button" 
                        class="btn btn-success px-5 py-2 fw-bold shadow-sm" 
                        id="btnOkSuccess">
                        <i class="bi bi-arrow-return-left me-2"></i>Aceptar y Volver
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        import { initCrearFactura } from "../scripts/crear_factura";
        document.addEventListener("DOMContentLoaded", initCrearFactura);
    </script>
</main>