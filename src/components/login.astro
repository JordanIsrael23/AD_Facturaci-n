<div class="login-wrapper">
    <div
        class="container d-flex align-items-center justify-content-center min-vh-100"
    >
        <div class="card login-card shadow-lg border-0">
            <div class="card-body p-5">
                <div class="text-center mb-5">
                    <div class="icon-circle mb-3 mx-auto">
                        <i
                            class="bi bi-person-lock text-white"
                            style="font-size: 2rem;"></i>
                    </div>
                    <h2 class="fw-bold text-dark">Bienvenido</h2>
                    <p class="text-muted small">
                        Sistema de Gestión y Facturación
                    </p>
                </div>

                <div
                    id="loginErrorAlert"
                    class="alert alert-danger d-none p-2 text-center small rounded-3"
                    role="alert"
                >
                </div>
                <div
                    id="loginSuccessAlert"
                    class="alert alert-success d-none p-2 text-center small rounded-3"
                    role="alert"
                >
                </div>

                <form id="loginForm" class="mt-4 needs-validation" novalidate>
                    <!-- Email / Username Input -->
                    <div class="mb-4 position-relative">
                        <label
                            for="email"
                            class="form-label text-secondary small fw-bold ms-1"
                            >USUARIO / EMAIL</label
                        >
                        <div class="input-group">
                            <span
                                class="input-group-text bg-light border-end-0 rounded-start-3 ps-3"
                                ><i class="bi bi-envelope text-primary"
                                ></i></span
                            >
                            <input
                                type="text"
                                class="form-control bg-light border-start-0 py-2 rounded-end-3"
                                id="email"
                                placeholder="usuario@utn.edu.ec"
                                required
                            />
                        </div>
                    </div>

                    <!-- Password Input -->
                    <div class="mb-4 position-relative">
                        <label
                            for="password"
                            class="form-label text-secondary small fw-bold ms-1"
                            >CONTRASEÑA</label
                        >
                        <div class="input-group">
                            <span
                                class="input-group-text bg-light border-end-0 rounded-start-3 ps-3"
                                ><i class="bi bi-key text-primary"></i></span
                            >
                            <input
                                type="password"
                                class="form-control bg-light border-start-0 py-2 rounded-end-3"
                                id="password"
                                placeholder="••••••••"
                                required
                            />
                        </div>
                    </div>

                    <div class="d-grid mt-5">
                        <button
                            type="submit"
                            id="btnSubmit"
                            class="btn btn-primary py-3 fw-bold text-uppercase shadow-hover rounded-3"
                        >
                            Ingresar
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-white border-0 text-center py-3">
                <small class="text-muted opacity-75"
                    >Universidad Técnica del Norte &copy; 2026</small
                >
            </div>
        </div>
    </div>
</div>

<script>
    import { initLogin } from "../scripts/login";
    document.addEventListener("DOMContentLoaded", () => {
        initLogin();
    });
</script>

