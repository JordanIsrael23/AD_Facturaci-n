---
import background from "../assets/background.svg";
---

<div class="container pt-3">
    <a href="/puntos-emision" class="btn btn-outline-secondary btn-sm mb-3">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="currentColor"
            class="bi bi-arrow-left me-1"
            viewBox="0 0 16 16"
        >
            <path
                fill-rule="evenodd"
                d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"
            ></path>
        </svg>
        Volver a Puntos de Emisión
    </a>
</div>

<div
    style={`background-image: url(${background.src}); background-size: cover; background-attachment: fixed; filter: blur(100px); position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;`}
>
</div>

<main class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm mt-4">
                <div class="card-body p-4">
                    <form id="formCrearPunto" autocomplete="off">
                        <h2 class="text-center text-primary mb-4">
                            Registrar Punto de Emisión<br />
                            <i class="bi bi-shop fs-1"></i>
                        </h2>

                        <div class="mb-3">
                            <label for="estRuc" class="form-label"
                                >Establecimiento</label
                            >
                            <div class="input-group">
                                <span class="input-group-text"
                                    ><i class="bi bi-building"></i></span
                                >
                                <select
                                    class="form-select"
                                    id="estRuc"
                                    name="est_ruc"
                                    required
                                >
                                    <option value="">Cargando...</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="pemCodigo" class="form-label"
                                >Código Punto Emisión</label
                            >
                            <div class="input-group">
                                <span class="input-group-text"
                                    ><i class="bi bi-123"></i></span
                                >
                                <input
                                    type="text"
                                    class="form-control"
                                    id="pemCodigo"
                                    name="pem_codigo"
                                    placeholder="Ej: 001, 002"
                                    maxlength="10"
                                    required
                                />
                            </div>
                            <div class="form-text">
                                Código numérico o alfanumérico que identifica el
                                punto.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="pemDescripcion" class="form-label"
                                >Descripción</label
                            >
                            <textarea
                                class="form-control"
                                id="pemDescripcion"
                                name="pem_descripcion"
                                rows="2"
                                placeholder="Ej: Caja Principal"
                                required></textarea>
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    name="pem_estado"
                                    id="pem_estado"
                                    checked
                                />
                                <label class="form-check-label" for="pem_estado"
                                    >Punto activo</label
                                >
                            </div>
                        </div>

                        <button
                            type="submit"
                            class="btn btn-primary w-100 fw-bold"
                            >Guardar Punto Emisión</button
                        >
                    </form>
                    <div class="container pt-3">
                        <a
                            href="/puntos-emision"
                            class="btn btn-outline-secondary w-100 fw-bold py-2 mb-3 d-flex align-items-center justify-content-center"
                        >
                            <i class="bi bi-x-circle me-2"></i>
                            Cancelar Registro
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-success border-3">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title d-flex align-items-center">
                    <i class="bi bi-check-circle-fill me-2 fs-4"></i>
                    Registro Exitoso
                </h5>
            </div>
            <div class="modal-body text-center p-4">
                <p class="lead text-dark">
                    ¡El punto de emisión ha sido creado correctamente!
                </p>
            </div>
            <div class="modal-footer justify-content-center">
                <button
                    type="button"
                    class="btn btn-success px-4"
                    id="btnOkSuccess">Aceptar</button
                >
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="errorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-danger border-3">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title d-flex align-items-center">
                    <i class="bi bi-exclamation-octagon-fill me-2 fs-4"></i>
                    Error de Validación
                </h5>
                <button
                    type="button"
                    class="btn-close btn-close-white"
                    data-bs-dismiss="modal"
                    aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-3">
                    <i
                        class="bi bi-x-circle text-danger"
                        style="font-size: 3rem;"></i>
                </div>
                <p class="text-dark fw-bold text-center">
                    No se pudo completar el registro:
                </p>
                <p
                    id="errorModalMsg"
                    class="text-muted small bg-light p-3 rounded border"
                >
                </p>
            </div>
            <div class="modal-footer justify-content-center border-0">
                <button
                    type="button"
                    class="btn btn-danger px-5"
                    data-bs-dismiss="modal">Corregir Datos</button
                >
            </div>
        </div>
    </div>
</div>

<script>
    import { initCrearPuntoEmision } from "../scripts/crear_punto_emision";
    document.addEventListener("DOMContentLoaded", initCrearPuntoEmision);
</script>
