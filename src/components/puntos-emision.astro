---
import background from "../assets/background.svg";
---

<div class="container pt-3">
    <div>
        <a href="/" class="btn btn-outline-secondary btn-sm mb-3">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-arrow-left me-1"
                viewBox="0 0 16 16"
            >
                <path
                    fill-rule="evenodd"
                    d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"
                ></path>
            </svg>
            Volver a Menu
        </a>
    </div>
</div>
<div
    style={`background-image: url(${background.src}); background-size: cover; background-attachment: fixed; filter: blur(100px); position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;`}
>
</div>

<main
    class="container-fluid d-flex flex-column align-items-center p-0 min-vh-100"
>
    <section class="container mt-5 p-3">
        <div
            class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2"
        >
            <div class="d-flex align-items-center">
                <h1 class="h2 text-primary fw-bold me-2 mb-0">
                    Puntos de Emisión
                </h1>
                <i class="bi bi-shop-window text-secondary fs-2"></i>
            </div>

            <div class="d-flex gap-2">
                <a
                    href="/crear-punto-emision"
                    class="btn btn-primary d-flex align-items-center"
                >
                    <i class="bi bi-plus-lg me-1"></i> Nuevo Punto
                </a>
            </div>
        </div>
        <!-- FILTROS -->
        <div class="row mb-3 justify-content-center">
            <div class="col-md-4">
                <div class="input-group">
                    <button
                        type="button"
                        class="input-group-text btn btn-outline-secondary btnFiltro"
                        data-for="filtroCodigo"
                    >
                        <i class="bi bi-funnel iconoFiltro"></i>
                    </button>
                    <input
                        type="text"
                        id="filtroCodigo"
                        class="form-control"
                        placeholder="Filtrar por código (ej: 001)"
                    />
                </div>
            </div>

            <div class="col-md-4">
                <div class="input-group">
                    <button
                        type="button"
                        class="input-group-text btn btn-outline-secondary btnFiltro"
                        data-for="filtroEstablecimiento"
                    >
                        <i class="bi bi-funnel iconoFiltro"></i>
                    </button>
                    <input
                        type="text"
                        id="filtroEstablecimiento"
                        class="form-control"
                        placeholder="Filtrar por establecimiento"
                    />
                </div>
            </div>
        </div>

        <div class="table-responsive shadow-sm rounded-3">
            <table
                class="table table-striped table-hover align-middle table-bordered"
            >
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Acciones</th>
                        <th scope="col">ID</th>
                        <th scope="col">Código</th>
                        <th scope="col">Establecimiento</th>
                        <th scope="col">Descripción</th>
                        <th scope="col">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Se llena dinámicamente -->
                </tbody>
            </table>
        </div>
        <div
            id="paginacion"
            class="d-flex justify-content-center align-items-center mt-3"
        >
        </div>
    </section>
</main>

<div
    class="modal fade"
    id="confirmDeleteModal"
    tabindex="-1"
    aria-labelledby="confirmDeleteModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-danger border-3">
            <div class="modal-header bg-danger text-white">
                <h5
                    class="modal-title d-flex align-items-center"
                    id="confirmDeleteModalLabel"
                >
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
                    Confirmar desactivación
                </h5>
                <button
                    type="button"
                    class="btn-close btn-close-white"
                    data-bs-dismiss="modal"
                    aria-label="Cerrar"></button>
            </div>

            <div class="modal-body text-center p-4">
                <p class="lead text-dark">
                    ¿Estás seguro que deseas desactivar el punto de emisión?
                </p>
                <p class="text-muted small">
                    Esta acción cambiará el estado del punto de emisión.
                </p>
            </div>

            <div class="modal-footer justify-content-center">
                <button
                    type="button"
                    class="btn btn-danger d-inline-flex align-items-center"
                    id="confirmDeleteBtn"
                >
                    <i class="bi bi-check-circle-fill me-1"></i> Aceptar
                </button>

                <button
                    type="button"
                    class="btn btn-outline-secondary d-inline-flex align-items-center"
                    data-bs-dismiss="modal"
                >
                    <i class="bi bi-x-circle-fill me-1"></i> Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    import { initPuntosEmision } from "../scripts/puntos_emision";
    // Astro ejecutará esto en el navegador
    document.addEventListener("DOMContentLoaded", () => {
        initPuntosEmision();
    });
</script>
