---
// Puedes importar tu layout si tienes uno, o dejarlo así para una página independiente
---

<div class="maintenance-container d-flex align-items-center justify-content-center min-vh-100">
    <div class="background-overlay"></div>

    <div class="container text-center position-relative">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                
                <div class="mb-4">
                    <i class="bi bi-gear-wide-connected display-1 neon-purple gear-rotate"></i>
                </div>

                <div class="glitch-wrapper mb-3">
                    <h1 class="display-2 fw-bold text-uppercase glitch" data-text="EN DESARROLLO">
                        EN DESARROLLO
                    </h1>
                </div>

                <p class="lead mb-5 neon-pink-text fs-4 fw-light">
                    Estamos trabajando en esta función para que sea <span class="fw-bold italic">increíble</span>.
                    <br/>
                    <small class="text-muted opacity-75">Vuelve pronto para descubrir las novedades.</small>
                </p>

                <div class="progress-container mb-5">
                    <div class="progress bg-transparent" style="height: 12px; border: 1px solid #9d00ff55;">
                        <div 
                            class="progress-bar progress-bar-striped progress-bar-animated neon-gradient-bar" 
                            role="progressbar" 
                            style="width: 65%">
                        </div>
                    </div>
                </div>

                <a href="/" class="btn btn-neon-pink btn-lg px-5 py-3 rounded-0 shadow-lg">
                    <i class="bi bi-chevron-left me-2"></i> REGRESAR AL PANEL
                </a>

            </div>
        </div>
    </div>
</div>

<style>
    /* VARIABLES DE COLORES */
    :root {
        --bg-dark: #050505;
        --neon-pink: #ff00ff;
        --neon-violet: #9d00ff;
        --text-shadow-pink: 0 0 10px rgba(255, 0, 255, 0.7);
    }

    .maintenance-container {
        background-color: var(--bg-dark);
        color: #ffffff;
        position: relative;
        overflow: hidden;
    }

    .background-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: radial-gradient(circle at center, #1a0033 0%, #050505 100%);
        opacity: 0.8;
    }

    /* ANIMACIÓN DEL ICONO (Rotación Constante) */
    .gear-rotate {
        display: inline-block;
        animation: rotateGear 4s linear infinite;
        filter: drop-shadow(0 0 10px var(--neon-violet));
    }

    @keyframes rotateGear {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* EFECTO GLITCH PARA EL TÍTULO */
    .glitch {
        position: relative;
        color: white;
        mix-blend-mode: lighten;
    }

    .glitch::before, .glitch::after {
        content: attr(data-text);
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: var(--bg-dark);
    }

    .glitch::before {
        left: 2px;
        text-shadow: -2px 0 #ff00ff;
        clip: rect(44px, 450px, 56px, 0);
        animation: glitch-anim 5s infinite linear alternate-reverse;
    }

    .glitch::after {
        left: -2px;
        text-shadow: -2px 0 #00ffff;
        clip: rect(44px, 450px, 56px, 0);
        animation: glitch-anim2 5s infinite linear alternate-reverse;
    }

    @keyframes glitch-anim {
        0% { clip: rect(31px, 9999px, 94px, 0); }
        20% { clip: rect(62px, 9999px, 42px, 0); }
        /* Añade más pasos para un efecto más errático */
        100% { clip: rect(80px, 9999px, 100px, 0); }
    }

    @keyframes glitch-anim2 {
        0% { clip: rect(65px, 9999px, 100px, 0); }
        100% { clip: rect(10px, 9999px, 30px, 0); }
    }

    /* ESTILOS DE TEXTO Y BARRA */
    .neon-pink-text {
        color: var(--neon-pink);
        text-shadow: var(--text-shadow-pink);
    }

    .neon-purple {
        color: var(--neon-violet);
    }

    .neon-gradient-bar {
        background: linear-gradient(90deg, var(--neon-violet), var(--neon-pink));
        box-shadow: 0 0 15px var(--neon-violet);
    }

    /* BOTÓN NEÓN */
    .btn-neon-pink {
        background: transparent;
        border: 2px solid var(--neon-pink);
        color: var(--neon-pink);
        letter-spacing: 2px;
        transition: all 0.3s ease;
        text-transform: uppercase;
    }

    .btn-neon-pink:hover {
        background: var(--neon-pink);
        color: #000;
        box-shadow: 0 0 30px var(--neon-pink);
        transform: translateY(-3px);
    }
</style>